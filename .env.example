# Django
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (matches docker-compose.dev.yml)
DATABASE_URL=postgresql://dip_user:dip_password@localhost:5432/document_intelligence

# Redis (matches docker-compose.dev.yml)
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_DEFAULT_QUEUE=documents-local

# OpenAI API (Phase 6+)
OPENAI_API_KEY=your-openai-api-key-here

# File upload (Phase 3) - bytes; allowed types are fixed in code (magic-byte check)
MAX_UPLOAD_SIZE=26214400
