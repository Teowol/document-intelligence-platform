# Production environment (Phase 10). Copy to .env before `docker compose up`.
# NEVER commit the real .env; use placeholders here.

# --- Django ---
DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(64))"
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1

# --- Database (matches compose) ---
POSTGRES_DB=document_intelligence
POSTGRES_USER=dip_user
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Flower (queue monitoring) ---
FLOWER_USER=admin
FLOWER_PASSWORD=change-me-strong-password

# --- Uploads ---
MAX_UPLOAD_SIZE=26214400
